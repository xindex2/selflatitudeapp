# ---------------------------------------------------------------------------
# SelfLatitude Companion - environment variables
# Copy to server/.env (development) or .env next to docker-compose.yml (production).
# Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Public URL of the app (used in emails, one-time links, and the allowed-origin check)
APP_URL=http://localhost:5173
# Extra origins allowed to make state-changing requests, comma separated. Only needed when
# the app answers on more than one hostname, e.g. ALLOWED_ORIGINS=https://www.selflatitude.com
# In development any localhost port is accepted automatically.
ALLOWED_ORIGINS=

# SQLite database file and uploaded course files
DB_PATH=./data/companion.db
UPLOAD_DIR=./uploads

# REQUIRED in production, and each must be different. Generate with:
#   openssl rand -base64 48
# The app refuses to start in production if either is short, low-variety, or looks like a
# placeholder.
#
# ENCRYPTION_KEY seals every stored secret (students' OpenAI keys, the SelfLatitude platform
# key, the SMTP password, the JVZoo secret, authenticator secrets). Losing it makes those
# unreadable; changing it needs `npm run rotate-key -w server` (see docs/DEPLOY.md).
ENCRYPTION_KEY=
# SESSION_SECRET keys session cookies and single-use links. Changing it signs everyone out.
SESSION_SECRET=
SESSION_DAYS=30

# SelfLatitude's OpenAI Platform key (funds included usage + embeddings)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Outgoing email (password resets, one-time links). Leave SMTP_HOST empty in dev to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SelfLatitude Companion <no-reply@selflatitude.com>"

# First Super Admin - created once on startup if no Super Admin exists
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Policy versions recorded with each consent
TERMS_VERSION=2026-01
PRIVACY_VERSION=2026-01
